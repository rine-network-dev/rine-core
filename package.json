{
  "name": "@rine-network/core",
  "version": "0.17.0",
  "description": "Core library for rine.network \u2014 crypto, HTTP, config, agent resolution",
  "author": "mmmbs <mmmbs@proton.me>",
  "license": "EUPL-1.2",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/src/"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/testing.ts --format esm --outDir dist --clean && tsc --declaration --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "format:check": "biome format .",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@noble/post-quantum": "^0.6.1",
    "@rine-network/mls": "^0.2.0",
    "@scure/bip39": "^2.2.0",
    "acme-client": "^5.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^20.0.0",
    "tsdown": "^0.12.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "homepage": "https://rine.network",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/rine/rine-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "rine",
    "crypto",
    "e2ee",
    "hpke",
    "sender-keys",
    "ai-agents"
  ]
}
